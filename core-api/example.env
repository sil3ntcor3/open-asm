# Config database
POSTGRES_HOST=localhost
POSTGRES_USERNAME=postgres
# Required for Compose: generate a unique secret of at least 32 characters.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_DB=open_asm
POSTGRES_SSL=false

PORT=6276
GRPC_PORT=16276
# Required: application authentication secret of at least 32 characters.
BETTER_AUTH_SECRET=
# Public Core API URL used for authentication callbacks.
BETTER_AUTH_URL=http://localhost:6276
# Used by local, non-Compose workers. Compose overrides this with WORKER_ENROLLMENT_TOKEN.
OASM_CLOUD_APIKEY=replace-with-a-random-secret-at-least-32-characters
# Required by Compose: shared API/worker enrollment secret of at least 32 characters.
WORKER_ENROLLMENT_TOKEN=replace-with-a-random-secret-at-least-32-characters
GRPC_BIND_HOST=0.0.0.0
GRPC_REFLECTION_ENABLED=false
# Optional mTLS. When enabled, all three certificate paths are mandatory.
GRPC_TLS_ENABLED=false
GRPC_TLS_CA_FILE=
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
# Required for Compose: generate a unique URI-safe secret of at least 32 characters.
REDIS_PASSWORD=
# Local API development should use the same REDIS_PASSWORD in this URL.
REDIS_URL=

GEO_IP_URL=localhost:4360

# RustFS Configuration
RUSTFS_ENDPOINT=http://localhost:9000
# Required for Compose: use a unique access key of at least 16 characters.
RUSTFS_ACCESS_KEY=
# Required for Compose: generate a unique secret of at least 32 characters.
RUSTFS_SECRET_KEY=
