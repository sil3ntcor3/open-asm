# Config database
POSTGRES_HOST=localhost
POSTGRES_USERNAME=postgres
# Required for Compose: generate a unique secret of at least 32 characters.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_DB=open_asm
POSTGRES_SSL=false

PORT=6276
GRPC_PORT=16276
# Public console origin used when generating the short-lived first-admin setup link.
OASM_CONSOLE_URL=http://localhost:3000
# Required for signing first-admin setup links; users never enter this value in the browser.
ADMIN_BOOTSTRAP_TOKEN=change_me
# Required: non-default worker enrollment secret with at least 32 characters.
OASM_CLOUD_APIKEY=replace-with-a-random-secret-at-least-32-characters
GRPC_BIND_HOST=0.0.0.0
GRPC_REFLECTION_ENABLED=false
# Optional mTLS. When enabled, all three certificate paths are mandatory.
GRPC_TLS_ENABLED=false
GRPC_TLS_CA_FILE=
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
# Required for Compose: generate a unique URI-safe secret of at least 32 characters.
REDIS_PASSWORD=
# Local API development should use the same REDIS_PASSWORD in this URL.
REDIS_URL=

GEO_IP_URL=localhost:4360

# RustFS Configuration
RUSTFS_ENDPOINT=http://localhost:9000
# Required for Compose: use a unique access key of at least 16 characters.
RUSTFS_ACCESS_KEY=
# Required for Compose: generate a unique secret of at least 32 characters.
RUSTFS_SECRET_KEY=
